@model PersonalInformationChangeViewModel
@{ViewData["Title"]="Yêu cầu thay đổi thông tin cá nhân";var requests=(IReadOnlyList<YeuCauCapNhatThongTinCaNhan>)(ViewBag.Requests??Array.Empty<YeuCauCapNhatThongTinCaNhan>());}
<div class="page-container">
 <form method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="col-md-6"><label asp-for="Email" class="custom-label"></label><input asp-for="Email" class="custom-input"/><span asp-validation-for="Email" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="SDT" class="custom-label"></label><input asp-for="SDT" class="custom-input"/></div>
  <div class="col-md-6"><label asp-for="NgaySinh" class="custom-label"></label><input asp-for="NgaySinh" class="custom-input"/></div>
  <div class="col-md-6"><label class="custom-label">Giới tính</label><select asp-for="GioiTinh" class="custom-input form-select"><option value="true">Nam</option><option value="false">Nữ</option></select></div>
  <div class="col-md-6"><label asp-for="CanCuocCongDan" class="custom-label"></label><input asp-for="CanCuocCongDan" class="custom-input"/></div>
  <div class="col-md-6"><label asp-for="SoTaiKhoan" class="custom-label"></label><input asp-for="SoTaiKhoan" class="custom-input"/></div>
  <div class="col-md-6"><label asp-for="MaSoThue" class="custom-label"></label><input asp-for="MaSoThue" class="custom-input"/></div>
  <div class="col-12"><label asp-for="DiaChi" class="custom-label"></label><input asp-for="DiaChi" class="custom-input"/></div>
  <div class="col-12"><label asp-for="LyDo" class="custom-label required"></label><textarea asp-for="LyDo" class="custom-input" rows="3"></textarea><span asp-validation-for="LyDo" class="text-danger"></span></div>
  <div class="col-12"><button class="btn-green-solid">Gửi</button></div>
 </form></div>
 <div class="custom-panel"><div class="panel-header">Lịch sử yêu cầu</div><div class="table-wrapper"><table class="custom-table"><thead><tr><th>Ngày gửi</th><th>Lý do</th><th>Trạng thái</th><th>Phản hồi</th></tr></thead><tbody>@foreach(var x in requests){<tr><td>@x.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@x.LyDo</td><td>@HrmDisplay.Leave(x.TrangThai)</td><td>@(x.PhanHoi??"—")</td></tr>}@if(!requests.Any()){<tr><td colspan="4" class="text-center text-muted">Chưa có yêu cầu.</td></tr>}</tbody></table></div></div>
</div>
