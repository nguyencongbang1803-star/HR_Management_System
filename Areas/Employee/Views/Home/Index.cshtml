@model EmployeePortalViewModel
@{
    ViewData["Title"] = "Thông tin nhân viên";
    var emp = Model.Employee;
    var today = DateTime.Today;
    var currentContract = Model.Contracts.FirstOrDefault(x => x.Trangthai && x.Ngaybatdau <= today && (!x.Ngayketthuc.HasValue || x.Ngayketthuc.Value >= today));
    var latestPayroll = Model.Payrolls.FirstOrDefault();
    var totalRemainingLeave = Math.Max(0, Model.LeaveBalances.Sum(x =>
        x.SoNgayDuocHuong + x.DieuChinh - Model.UsedLeaveDaysByType.GetValueOrDefault(x.LoaiNghiPhepID)));
}

<div class="page-container py-3">
    <div class="profile-hero-card mb-4">
        <div class="row g-0 align-items-center">
            <div class="col-md-3 profile-avatar-block border-end">
                <div class="profile-avatar-wrap">
                    @if (!string.IsNullOrWhiteSpace(emp.AnhDaiDien))
                    {
                        <img class="profile-avatar-img" src="@Url.Action("Employee","Avatar",new{area="",id=emp.ID,v=emp.AnhDaiDien})" alt="Ảnh đại diện của @emp.Ten" />
                    }
                    else
                    {
                        <div class="profile-avatar-placeholder">@emp.Ten.Trim()[0].ToString().ToUpperInvariant()</div>
                    }
                    <button type="button" class="profile-avatar-edit" data-bs-toggle="modal" data-bs-target="#avatarModal" title="Cập nhật ảnh đại diện">✏</button>
                </div>
            </div>
            <div class="col-md-9 p-4">
                <h4 class="fw-bold text-dark mb-1">@emp.Ten</h4>
                <div class="text-muted mb-3">@emp.MaNhanVien</div>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge-status status-info">@(emp.PhongBan?.Tenphongban ?? "Chưa có phòng ban")</span>
                    <span class="badge-status status-success">@(emp.ChucVu?.Chucvu ?? "Chưa có chức vụ")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="profile-side-nav">
                <button type="button" class="profile-nav-item js-profile-tab active" data-tab="tab-personal"><span>Thông tin cá nhân</span></button>
                <button type="button" class="profile-nav-item js-profile-tab" data-tab="tab-job"><span>Thông tin công việc</span></button>
                <button type="button" class="profile-nav-item js-profile-tab" data-tab="tab-benefit"><span>Thông tin phúc lợi</span></button>
                <button type="button" class="profile-nav-item js-profile-tab" data-tab="tab-insurance"><span>Thông tin bảo hiểm</span></button>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="profile-tab-pane" id="tab-personal">
                <div class="custom-panel">
                    <div class="panel-header d-flex justify-content-between align-items-center">
                        <span>Thông tin cá nhân</span>
                        <a asp-action="RequestPersonalInformationChange" class="btn-green-outline py-1 px-3">Yêu cầu thay đổi</a>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6"><label class="form-label text-muted">Họ và tên</label><div class="fw-semibold border-bottom pb-2">@emp.Ten</div></div>
                        <div class="col-md-6"><label class="form-label text-muted">Ngày sinh</label><div class="fw-semibold border-bottom pb-2">@(emp.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div></div>
                        <div class="col-md-6"><label class="form-label text-muted">Email</label><div class="fw-semibold border-bottom pb-2 text-break">@(emp.Email ?? "Chưa cập nhật")</div></div>
                        <div class="col-md-6"><label class="form-label text-muted">Số điện thoại</label><div class="fw-semibold border-bottom pb-2">@(emp.SDT ?? "Chưa cập nhật")</div></div>
                        <div class="col-md-6"><label class="form-label text-muted">CCCD/Hộ chiếu</label><div class="fw-semibold border-bottom pb-2">@(emp.CanCuocCongDan ?? "Chưa cập nhật")</div></div>
                    </div>
                </div>

                <div class="custom-panel">
                    <div class="panel-header">Bằng cấp và chứng chỉ</div>
                    <div class="table-wrapper">
                        <table class="custom-table mb-0">
                            <thead><tr><th>Loại</th><th>Tên bằng cấp/chứng chỉ</th><th>Đơn vị cấp</th><th>Ngày cấp</th></tr></thead>
                            <tbody>
                                @foreach (var qualification in Model.Qualifications)
                                {
                                    <tr><td>@(qualification.Loai == "BangCap" ? "Bằng cấp" : "Chứng chỉ")</td><td><strong>@qualification.Ten</strong></td><td>@(qualification.DonViCap ?? "—")</td><td>@(qualification.NgayCap?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                                }
                                @if (!Model.Qualifications.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-4">Chưa có thông tin bằng cấp.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="profile-tab-pane d-none" id="tab-job">
                <div class="custom-panel">
                    <div class="panel-header">Thông tin công việc</div>
                    <div class="row g-4">
                        <div class="col-md-6"><label class="form-label text-muted">Chức vụ</label><div class="fw-semibold border-bottom pb-2">@(emp.ChucVu?.Chucvu ?? "Chưa cập nhật")</div></div>
                        <div class="col-md-6"><label class="form-label text-muted">Phòng ban</label><div class="fw-semibold border-bottom pb-2">@(emp.PhongBan?.Tenphongban ?? "Chưa cập nhật")</div></div>
                        <div class="col-md-6"><label class="form-label text-muted">Vị trí làm việc</label><div class="fw-semibold border-bottom pb-2">@($"{emp.ChucVu?.Chucvu ?? "Chưa cập nhật"} · {emp.PhongBan?.Tenphongban ?? "Chưa cập nhật"}")</div></div>
                        <div class="col-md-6"><label class="form-label text-muted">Loại hợp đồng hiện tại</label><div class="fw-semibold border-bottom pb-2">@(currentContract?.Loaihopdong ?? "Chưa có hợp đồng hiệu lực")</div></div>
                    </div>
                </div>
            </div>

            <div class="profile-tab-pane d-none" id="tab-benefit">
                <section class="metric-grid mb-4">
                    <div class="metric custom-panel mb-0 text-center"><div class="metric-label">Ngày nghỉ còn lại</div><div class="metric-value fs-4">@totalRemainingLeave.ToString("0.##") ngày</div></div>
                    <div class="metric custom-panel mb-0 text-center"><div class="metric-label">Lương cơ bản hiện tại</div><div class="metric-value fs-4">@((currentContract?.Luongcoban ?? latestPayroll?.Luongcoban ?? 0).ToString("N0")) ₫</div></div>
                    <div class="metric custom-panel mb-0 text-center"><div class="metric-label">Tổng phụ cấp</div><div class="metric-value fs-4">@((Model.Allowances.Sum(x => x.SoTien) + Model.ScopedAllowances.Sum(x => x.SoTien)).ToString("N0")) ₫</div></div>
                </section>

                <div class="custom-panel">
                    <div class="panel-header">Phụ cấp</div>
                    <div class="table-wrapper"><table class="custom-table mb-0"><thead><tr><th>Tên phụ cấp</th><th>Ngày áp dụng</th><th>Số tiền</th></tr></thead><tbody>
                        @foreach (var allowance in Model.Allowances){<tr><td>@allowance.TenPhuCap</td><td>@allowance.NgayApDung.ToString("dd/MM/yyyy")</td><td>@allowance.SoTien.ToString("N0") ₫</td></tr>}
                        @foreach (var allowance in Model.ScopedAllowances){<tr><td>@allowance.TenPhuCap</td><td>Từ @allowance.NgayBatDau.ToString("MM/yyyy") · @(allowance.KieuThoiHan == AllowanceDurations.Monthly ? "Mỗi tháng" : $"{allowance.SoThang} tháng")</td><td>@allowance.SoTien.ToString("N0") ₫</td></tr>}
                        @if (!Model.Allowances.Any() && !Model.ScopedAllowances.Any()){<tr><td colspan="3" class="text-center text-muted py-4">Chưa có phụ cấp.</td></tr>}
                    </tbody></table></div>
                </div>

                <div class="custom-panel">
                    <div class="panel-header">Danh sách bảng lương</div>
                    <div class="table-wrapper">
                        <table class="custom-table mb-0">
                            <thead><tr><th>Kỳ lương</th><th>Ngày công</th><th>Lương cơ bản</th><th>Phụ cấp</th><th>Tăng ca</th><th>Khấu trừ &amp; bảo hiểm</th><th>Thực lĩnh</th><th>Trạng thái</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var payroll in Model.Payrolls)
                            {
                                <tr>
                                    <td><strong>@payroll.Thang.ToString("00")/@payroll.Nam</strong></td>
                                    <td>@payroll.SoNgayCong.ToString("0.##")/@payroll.SoNgayChuan</td>
                                    <td>@payroll.Luongcoban.ToString("N0") ₫</td>
                                    <td>@payroll.Phucap.ToString("N0") ₫</td>
                                    <td>@payroll.SoGioTangCa.ToString("0.##") giờ<br/><small class="text-muted">@payroll.TienTangCa.ToString("N0") ₫</small></td>
                                    <td>@((payroll.Khautru + payroll.BaoHiem).ToString("N0")) ₫</td>
                                    <td><strong class="text-success">@payroll.Tongluong.ToString("N0") ₫</strong></td>
                                    <td><span class="badge-status @(payroll.TrangThai == PayrollStatuses.Paid ? "status-success" : payroll.TrangThai == PayrollStatuses.Locked ? "status-warning" : "status-info")">@HrmDisplay.Payroll(payroll.TrangThai)</span></td>
                                    <td><a class="btn-green-outline btn-sm" asp-action="Attendance" asp-route-thang="@payroll.Thang" asp-route-nam="@payroll.Nam">Chi tiết</a></td>
                                </tr>
                            }
                            @if (!Model.Payrolls.Any())
                            {
                                <tr><td colspan="9" class="text-center text-muted py-4">Chưa có bảng lương được phát hành.</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="custom-panel">
                    <div class="panel-header">Danh sách hợp đồng</div>
                    <div class="table-wrapper"><table class="custom-table mb-0"><thead><tr><th>Số hợp đồng</th><th>Loại hợp đồng</th><th>Thời hạn</th><th>Lương cơ bản</th></tr></thead><tbody>
                        @foreach (var contract in Model.Contracts){<tr><td><strong>@contract.SoHopDong</strong></td><td>@contract.Loaihopdong</td><td>@contract.Ngaybatdau.ToString("dd/MM/yyyy") – @(contract.Ngayketthuc?.ToString("dd/MM/yyyy") ?? "Không thời hạn")</td><td>@contract.Luongcoban.ToString("N0") ₫</td></tr>}
                        @if (!Model.Contracts.Any()){<tr><td colspan="4" class="text-center text-muted py-4">Chưa có hợp đồng.</td></tr>}
                    </tbody></table></div>
                </div>
            </div>

            <div class="profile-tab-pane d-none" id="tab-insurance">
                <div class="custom-panel">
                    <div class="panel-header">Thông tin bảo hiểm và thuế</div>
                    <div class="row g-4 mb-4">
                        <div class="col-md-6"><label class="form-label text-muted">Bảo hiểm xã hội</label><div class="fw-semibold border-bottom pb-2">@(Model.ScopedInsurances.Any() || Model.Insurances.Any(x => x.LoaiBaoHiem?.TenLoaiBaoHiem.Contains("xã hội", StringComparison.OrdinalIgnoreCase) == true || x.LoaiBaoHiem?.TenLoaiBaoHiem.Contains("BHXH", StringComparison.OrdinalIgnoreCase) == true) ? "Đã tham gia" : "Chưa cập nhật")</div></div>
                        <div class="col-md-6"><label class="form-label text-muted">Mã số thuế</label><div class="fw-semibold border-bottom pb-2">@(emp.MaSothue ?? "Chưa cập nhật")</div></div>
                    </div>
                    <div class="table-wrapper"><table class="custom-table mb-0"><thead><tr><th>Loại bảo hiểm</th><th>Mức đóng</th><th>Thời gian</th></tr></thead><tbody>
                        @foreach (var insurance in Model.Insurances){<tr><td>@insurance.LoaiBaoHiem?.TenLoaiBaoHiem</td><td>@insurance.SoTienDong.ToString("N0") ₫</td><td>@insurance.NgayBatDau.ToString("dd/MM/yyyy") – @(insurance.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "Hiện tại")</td></tr>}
                        @foreach (var insurance in Model.ScopedInsurances){<tr><td>@insurance.TenKhoan</td><td>@insurance.SoTienDong.ToString("N0") ₫/tháng</td><td>Từ @insurance.NgayBatDau.ToString("MM/yyyy") · @(insurance.KieuThoiHan == AllowanceDurations.Monthly ? "Mỗi tháng" : $"{insurance.SoThang} tháng")</td></tr>}
                        @if (!Model.Insurances.Any() && !Model.ScopedInsurances.Any()){<tr><td colspan="3" class="text-center text-muted py-4">Chưa có thông tin bảo hiểm.</td></tr>}
                    </tbody></table></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="avatarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Ảnh đại diện</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
        <form asp-action="UpdateAvatar" method="post" enctype="multipart/form-data"><label class="custom-label required">Chọn ảnh JPG hoặc PNG</label><input name="avatar" type="file" accept="image/jpeg,image/png" class="custom-input mb-3" required/><button class="btn-green-solid" type="submit">Cập nhật ảnh</button></form>
        @if (!string.IsNullOrWhiteSpace(emp.AnhDaiDien)){<form asp-action="RemoveAvatar" method="post" class="mt-3" onsubmit="return confirm('Xóa ảnh đại diện hiện tại?');"><button class="btn-green-outline text-danger" type="submit">Xóa ảnh hiện tại</button></form>}
    </div></div></div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.js-profile-tab').forEach(button => button.addEventListener('click', () => {
    document.querySelectorAll('.js-profile-tab').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.profile-tab-pane').forEach(x => x.classList.add('d-none'));
    button.classList.add('active');
    document.getElementById(button.dataset.tab)?.classList.remove('d-none');
}));
</script>
}
