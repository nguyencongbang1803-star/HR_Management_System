@model PositionIndexViewModel
@{
    ViewData["Title"] = "Chức vụ";
    string SortIcon(string column) => Model.Sort == column ? (Model.Descending ? "↓" : "↑") : "↕";
    bool NextDirection(string column) => Model.Sort == column && !Model.Descending;
    var canAssignAdmin = User.IsInRole(AuthorizationRoles.Administrator);
    var assignableRoles = AuthorizationRoles.All.Where(role => canAssignAdmin || role != AuthorizationRoles.Administrator).ToList();
    string RoleLabel(string role) => role switch
    {
        AuthorizationRoles.Employee => "Nhân viên",
        AuthorizationRoles.Manager => "Quản lý",
        AuthorizationRoles.HumanResources => "HR",
        AuthorizationRoles.Administrator => "Admin",
        _ => role
    };
}



<div class="page-container">
    <!-- Panel Tìm kiếm -->
    <div class="custom-panel">
        <div class="panel-header" data-bs-toggle="collapse" data-bs-target="#searchSection">
            <span>Chức vụ</span>
            <span class="toggle-icon">▲</span>
        </div>
        <div id="searchSection" class="collapse show">
            <form method="get" data-auto-submit-search>
                <div class="row g-4 align-items-end justify-content-between">
                    <div class="col-md-3">
                        <label class="custom-label" for="position-search">Tên chức vụ</label>
                        <input id="position-search" name="search" value="@Model.Search" class="custom-input" placeholder="Nhập tên chức vụ..." />
                    </div>
                    <!-- <div class="col-md-3">
                        <label class="custom-label" for="minimum-coefficient">Hệ số từ</label>
                        <input id="minimum-coefficient" name="minCoefficient" value="@Model.MinCoefficient" type="number" min="0" max="100" step="0.01" class="custom-input" placeholder="0,00" />
                    </div>
                    <div class="col-md-3">
                        <label class="custom-label" for="maximum-coefficient">Hệ số đến</label>
                        <input id="maximum-coefficient" name="maxCoefficient" value="@Model.MaxCoefficient" type="number" min="0" max="100" step="0.01" class="custom-input" placeholder="100,00" />
                    </div> -->
                    
                    <!-- Phần nút bấm nằm chung một hàng, chiếm 1 cột cuối -->
                      <div class="col-md-6 d-flex justify-content-end gap-3">
                        <a class="btn-green-outline" asp-action="Index">Tất cả</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Panel Kết quả -->
    <div class="custom-panel">
        <button class="btn-green-solid" type="button" data-bs-toggle="modal" data-bs-target="#createPosition">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            Thêm chức vụ mới
        </button>
        
        <div class="record-count">(@Model.Items.Count) Records Found</div>
        
        <div class="table-wrapper">
            <table class="custom-table">
                <thead>
                    <tr>
                        
                        <th>
                            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-minCoefficient="@Model.MinCoefficient" asp-route-maxCoefficient="@Model.MaxCoefficient" asp-route-sort="name" asp-route-descending="@NextDirection("name")">
                                Tên chức vụ <span class="ms-1">@SortIcon("name")</span>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-minCoefficient="@Model.MinCoefficient" asp-route-maxCoefficient="@Model.MaxCoefficient" asp-route-sort="coefficient" asp-route-descending="@NextDirection("coefficient")">
                                Hệ số lương <span class="ms-1">@SortIcon("coefficient")</span>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-minCoefficient="@Model.MinCoefficient" asp-route-maxCoefficient="@Model.MaxCoefficient" asp-route-sort="employees" asp-route-descending="@NextDirection("employees")">
                                Nhân sự <span class="ms-1">@SortIcon("employees")</span>
                            </a>
                        </th>
                        <th>Phép năm</th>
                        <th>Nhóm quyền</th>
                        <th class="text-center" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            
                            <td>@item.Position.Chucvu</td>
                            <td>@(item.Position.Hesoluong?.ToString("0.##") ?? "—")</td>
                            <td>@item.EmployeeCount</td>
                            <td>@item.Position.SoNgayPhepNam.ToString("0.##") ngày</td>
                            <td>
                                @foreach(var role in AuthorizationRoles.Parse(item.Position.PhanQuyen)){<span class="badge rounded-pill text-bg-light me-1">@role</span>}
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center">
                                    <form asp-action="Delete" asp-route-id="@item.Position.ID" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa chức vụ này?');" style="display:inline;">
                                        <button class="action-btn" type="submit" title="Xóa">
                                            <!-- SVG Thùng rác -->
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                        </button>
                                    </form>
                                    <button class="action-btn" type="button" title="Sửa" data-bs-toggle="modal" data-bs-target="#editPosition-@item.Position.ID">
                                        <!-- SVG Cây bút -->
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <button class="action-btn" type="button" title="Xem nhân viên" data-bs-toggle="modal" data-bs-target="#staffPosition-@item.Position.ID" style="color: #48bb78;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Không tìm thấy chức vụ phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm chức vụ -->
<div class="modal fade" id="createPosition" tabindex="-1" aria-labelledby="createPositionTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Save" method="post" class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="createPositionTitle" style="color:#4a5468; font-weight: 600;">Thêm chức vụ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="custom-label required" for="new-position-name">Tên chức vụ</label>
                    <input id="new-position-name" name="Chucvu" class="custom-input" required maxlength="100" />
                </div>
                <div class="mb-3">
                    <label class="custom-label" for="new-position-coefficient">Hệ số lương</label>
                    <input id="new-position-coefficient" name="Hesoluong" type="number" min="0" max="100" step="0.01" class="custom-input" />
                </div>
                <div>
                    <label class="custom-label required" for="new-position-leave-quota">Số ngày phép năm</label>
                    <input id="new-position-leave-quota" name="SoNgayPhepNam" value="16" type="number" min="0" max="365" step="0.5" class="custom-input" required />
                    <small class="text-muted">Chức vụ mới mặc định có 16 ngày phép năm.</small>
                </div>
                <div class="mt-3">
                    <label class="custom-label required" for="new-position-role">Nhóm quyền hệ thống</label>
                    <div id="new-position-role" class="position-role-options">
                        @foreach(var role in assignableRoles){<label class="position-role-option"><input class="form-check-input" type="checkbox" name="PhanQuyens" value="@role" checked="@(role==AuthorizationRoles.Employee)"/><span>@RoleLabel(role)</span></label>}
                    </div>
                    @if(!canAssignAdmin){<small class="d-block text-muted">Nhóm quyền Admin chỉ do quản trị viên thiết lập.</small>}
                    <small class="text-muted">Mọi nhân viên có chức vụ này sẽ nhận toàn bộ các nhóm quyền đã chọn.</small>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn-green-solid">Lưu</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa chức vụ -->
@foreach (var item in Model.Items)
{
    <div class="modal fade" id="editPosition-@item.Position.ID" tabindex="-1" aria-labelledby="editPositionTitle-@item.Position.ID" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="Save" method="post" class="modal-content">
                <input type="hidden" name="ID" value="@item.Position.ID" />
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="editPositionTitle-@item.Position.ID" style="color:#4a5468; font-weight: 600;">Sửa chức vụ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="custom-label required" for="position-name-@item.Position.ID">Tên chức vụ</label>
                        <input id="position-name-@item.Position.ID" name="Chucvu" value="@item.Position.Chucvu" class="custom-input" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="custom-label" for="position-coefficient-@item.Position.ID">Hệ số lương</label>
                        <input id="position-coefficient-@item.Position.ID" name="Hesoluong" value="@item.Position.Hesoluong" type="number" min="0" max="100" step="0.01" class="custom-input" />
                    </div>
                    <div>
                        <label class="custom-label required" for="position-leave-quota-@item.Position.ID">Số ngày phép năm</label>
                        <input id="position-leave-quota-@item.Position.ID" name="SoNgayPhepNam" value="@item.Position.SoNgayPhepNam" type="number" min="0" max="365" step="0.5" class="custom-input" required />
                    </div>
                    <div class="mt-3">
                        <label class="custom-label required" for="position-role-@item.Position.ID">Nhóm quyền hệ thống</label>
                        @if (canAssignAdmin || !AuthorizationRoles.Contains(item.Position.PhanQuyen, AuthorizationRoles.Administrator))
                        {
                            <div id="position-role-@item.Position.ID" class="position-role-options">@foreach(var role in assignableRoles){<label class="position-role-option"><input class="form-check-input" type="checkbox" name="PhanQuyens" value="@role" checked="@AuthorizationRoles.Contains(item.Position.PhanQuyen,role)"/><span>@RoleLabel(role)</span></label>}</div>
                            @if(!canAssignAdmin){<small class="d-block text-muted">Nhóm quyền Admin chỉ do quản trị viên thiết lập.</small>}
                        }
                        else
                        {
                            @foreach(var role in AuthorizationRoles.Parse(item.Position.PhanQuyen)){<input type="hidden" name="PhanQuyens" value="@role" />}
                            <div class="custom-input bg-light">Admin</div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-green-solid">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Modals xem danh sách nhân viên đang làm việc theo chức vụ -->
@foreach (var item in Model.Items)
{
    <div class="modal fade" id="staffPosition-@item.Position.ID" tabindex="-1" aria-labelledby="staffPositionTitle-@item.Position.ID" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <div>
                        <h5 class="modal-title" id="staffPositionTitle-@item.Position.ID" style="color:#4a5468; font-weight: 600;">
                            Nhân viên – @item.Position.Chucvu
                        </h5>
                        <small class="text-muted">@item.Employees.Count nhân viên đang làm việc</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body px-4">
                    @if (item.Employees.Count == 0)
                    {
                        <div class="text-center py-5" style="color: #5c6c85;">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 d-block mx-auto"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            Chức vụ này chưa có nhân viên đang làm việc.
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="custom-table mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:40px;">#</th>
                                        <th>Mã NV</th>
                                        <th>Họ và tên</th>
                                        <th>Phòng ban</th>
                                        <th>Email</th>
                                        <th>SĐT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var rowNumber = 0; }
                                    @foreach (var employee in item.Employees)
                                    {
                                        rowNumber++;
                                        <tr>
                                            <td class="text-muted">@rowNumber</td>
                                            <td><strong style="color:#4a5468;">@employee.MaNhanVien</strong></td>
                                            <td>@employee.Ten</td>
                                            <td>@(employee.PhongBan?.Tenphongban ?? "—")</td>
                                            <td style="font-size:13px;">@(employee.Email ?? "—")</td>
                                            <td style="font-size:13px;">@(employee.SDT ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0">
                    <a asp-area="HR" asp-controller="NhanVien" asp-action="Index" asp-route-positionId="@item.Position.ID" class="btn-green-outline">Xem tất cả trong DS nhân viên</a>
                    <button type="button" class="btn-green-solid" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}
