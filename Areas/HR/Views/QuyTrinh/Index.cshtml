@model IReadOnlyList<QuyTrinhPheDuyet>
@{ViewData["Title"]="Luồng phê duyệt";}

<div class="page-container">
    <!-- Panel Thiết lập -->
    <div class="custom-panel">
        <div class="panel-header" data-bs-toggle="collapse" data-bs-target="#workflowSection">
            <span>Luồng phê duyệt</span>
            <span class="toggle-icon">▲</span>
        </div>
        <div id="workflowSection" class="collapse show">
        <form asp-action="Save" method="post" class="row g-3 align-items-end m-0">
            <div class="col-md-3">
                <label class="custom-label">Loại yêu cầu</label>
                <select name="requestType" class="custom-input form-select">
                    <option value="Leave">Nghỉ phép</option>
                    <option value="Overtime">Tăng ca</option>
                    <option value="BusinessTrip">Công tác</option>
                    <option value="AttendanceAdjustment">Điều chỉnh công</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="custom-label">Tên quy trình</label>
                <input name="name" required class="custom-input" placeholder="Tên quy trình"/>
            </div>
            <div class="col-md-4">
                <label class="custom-label">Các bước xử lý</label>
                <input name="steps" required class="custom-input" placeholder="QuanLy, HR, Admin"/>
            </div>
            <div class="col-md-2 d-flex justify-content-end gap-3">
                <button class="btn-green-solid w-100 p-2">Lưu luồng</button>
            </div>
        </form>
        <div class="mt-2 text-muted px-2" style="font-size: 12px;">Nhập vai trò theo thứ tự, phân cách bằng dấu phẩy: QuanLy, HR, Admin.</div>
        </div>
    </div>

    <!-- Panel Kết quả -->
    <div class="custom-panel">
        <div class="record-count">(@Model.Count) Records Found</div>
        <div class="table-wrapper">
            <table class="custom-table">
            <thead>
                <tr>
                    <th>Loại yêu cầu</th>
                    <th>Tên quy trình</th>
                    <th>Các bước</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var x in Model){
                    <tr>
                        <td><strong style="color: #4a5468;">@x.LoaiYeuCau</strong></td>
                        <td>@x.TenQuyTrinh</td>
                        <td style="color: #48bb78; font-weight: 500;">
                            @string.Join(" → ",x.CacBuoc.OrderBy(b=>b.ThuTu).Select(b=>b.VaiTroDuyet))
                        </td>
                        <td>
                            <span class="badge-status @(x.HoatDong?"status-success":"status-danger")">
                                @(x.HoatDong?"Đang dùng":"Tạm dừng")
                            </span>
                        </td>
                        <td class="text-center">
                            <form asp-action="Toggle" asp-route-id="@x.ID" method="post" class="m-0">
                                <button class="action-btn" title="Đổi trạng thái">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"></path><path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"></path></svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if(Model.Count==0){
                    <tr><td colspan="5" class="text-center py-4" style="color:#5c6c85;">Chưa có luồng tùy chỉnh; hệ thống sử dụng quyền mặc định.</td></tr>
                }
            </tbody>
            </table>
        </div>
    </div>
</div>
