@model IReadOnlyList<SoDuNghiPhep>
@{
    ViewData["Title"]="Quỹ nghỉ phép";
    var employees=(IEnumerable<NhanVien>)ViewBag.NhanViens;
    var types=(IEnumerable<LoaiNghiPhep>)ViewBag.LoaiNghi;
}

<div class="page-container">
    <!-- Panel Thiết lập -->
    <div class="custom-panel">
        <div class="panel-header" data-bs-toggle="collapse" data-bs-target="#balanceSection">
            <span>Quỹ nghỉ phép</span>
            <span class="toggle-icon">▲</span>
        </div>
        <div id="balanceSection" class="collapse show">
        <form asp-action="SaveBalance" method="post">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="custom-label">Nhân viên</label>
                    <select name="NhanVienID" class="custom-input form-select employee-select" required>
                        <option value="">Chọn nhân viên</option>
                        @foreach(var x in employees){
                            <option value="@x.ID" data-employee-code="@x.MaNhanVien" data-employee-name="@x.Ten" data-leave-quota="@(x.ChucVu?.SoNgayPhepNam??16m)">@x.MaNhanVien - @x.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="custom-label">Loại nghỉ phép</label>
                    <select name="LoaiNghiPhepID" class="custom-input form-select" required>
                        @foreach(var x in types.Where(x=>x.TruQuyPhep)){
                            <option value="@x.ID">@x.TenLoai</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="custom-label">Năm</label>
                    <input name="Nam" value="@ViewBag.Nam" type="number" class="custom-input"/>
                </div>
                <div class="col-md-2">
                    <label class="custom-label">Hạn mức theo chức vụ</label>
                    <input id="position-leave-quota" value="16" type="number" step="0.5" class="custom-input" readonly/>
                </div>
                <div class="col-md-1">
                    <label class="custom-label">Điều chỉnh</label>
                    <input name="DieuChinh" value="0" type="number" step="0.5" class="custom-input"/>
                </div>
                <div class="col-md-1 d-flex justify-content-end gap-3">
                    <button class="btn-green-solid w-100 p-2" type="submit">Lưu</button>
                </div>
            </div>
        </form>
        </div>
    </div>

    <!-- Panel Kết quả -->
    <div class="custom-panel">
        <form method="get" class="d-flex justify-content-end align-items-center gap-3" data-auto-submit-search>
            <label class="custom-label mb-0" for="leave-year">Năm</label>
            <input id="leave-year" name="nam" type="number" value="@ViewBag.Nam" class="custom-input" style="width:120px;" />
        </form>
        <div class="record-count">(@Model.Count) Records Found</div>
        <div class="table-wrapper">
            <table class="custom-table">
            <thead>
                <tr>
                    <th>Nhân viên</th>
                    <th>Chức vụ</th>
                    <th>Loại nghỉ</th>
                    <th>Năm</th>
                    <th>Hạn mức</th>
                    <th>Điều chỉnh</th>
                    <th>Tổng cộng</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var x in Model){
                    <tr>
                        <td>
                            <strong style="color:#4a5468;">@x.NhanVien?.Ten</strong>
                            <div class="small text-muted">@x.NhanVien?.MaNhanVien</div>
                        </td>
                        <td>@(x.NhanVien?.ChucVu?.Chucvu??"Chưa có chức vụ")</td>
                        <td>@x.LoaiNghiPhep?.TenLoai</td>
                        <td>@x.Nam</td>
                        <td>@x.SoNgayDuocHuong</td>
                        <td>@x.DieuChinh</td>
                        <td><strong style="color:#2d3748;">@(x.SoNgayDuocHuong+x.DieuChinh)</strong></td>
                    </tr>
                }
                @if(Model.Count==0){
                    <tr><td colspan="7" class="text-center py-4" style="color:#5c6c85;">Chưa có nhân viên để hiển thị quỹ phép.</td></tr>
                }
            </tbody>
            </table>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const employeeSelect = document.querySelector('select[name="NhanVienID"]');
    const quotaInput = document.getElementById('position-leave-quota');
    if (!employeeSelect || !quotaInput) return;
    const updateQuota = () => {
        const selected = employeeSelect.options[employeeSelect.selectedIndex];
        quotaInput.value = selected?.dataset.leaveQuota || '16';
    };
    employeeSelect.addEventListener('change', updateQuota);
    updateQuota();
});
</script>
