</style>

@section Scripts {
    <script>
        (() => {
            // ── Edit mode toggle ──────────────────────
            const panel = document.getElementById('orgPanel');
            const addBtn = document.getElementById('btn-add-dept');
            const editSwitch = document.getElementById('orgEditMode');
            editSwitch?.addEventListener('change', () => {
                const editing = editSwitch.checked;
                panel?.classList.toggle('is-editing', editing);
                if (addBtn) addBtn.style.display = editing ? 'inline-flex' : 'none';
            });

            // ── Add root/child department ────────────
            const createModal = document.getElementById('createDepartment');
            const createForm = createModal?.querySelector('form');
            const createTitle = document.getElementById('createDeptTitle');
            const parentSelect = document.getElementById('new-dept-parent');
            document.querySelectorAll('[data-add-department]').forEach(button => {
                button.addEventListener('click', () => {
                    const parentId = button.dataset.parentDepartment ?? '';
                    const parentName = button.dataset.parentName ?? '';
                    if (parentSelect) {
                        parentSelect.value = parentId;
                        parentSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    if (createTitle) {
                        createTitle.textContent = parentId
                            ? `Thêm đơn vị trực thuộc ${parentName}`
                            : 'Thêm phòng ban mới';
                    }
                });
            });
            createModal?.addEventListener('hidden.bs.modal', () => {
                createForm?.reset();
                if (createTitle) createTitle.textContent = 'Thêm phòng ban mới';
            });

            // ── Tree collapse/expand (Smooth Transition) ──────────────────
            document.querySelectorAll('[data-tree-toggle]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const targetId = btn.dataset.treeToggle;
                    const target = document.getElementById(targetId);
                    if (!target) return;

                    const isCollapsed = target.classList.toggle('is-collapsed');
                    btn.setAttribute('aria-expanded', String(!isCollapsed));
                });
            });
        })();
    </script>
}
