@model EmployeeFormViewModel
@{ ViewData["Title"] = "Cập nhật nhân viên"; }

<div class="page-container">
    <div class="custom-panel">
        <div class="panel-header">Cập nhật nhân viên · @Model.MaNhanVien</div>
        <form asp-action="Edit" asp-route-id="@Model.ID" method="post" enctype="multipart/form-data">
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
