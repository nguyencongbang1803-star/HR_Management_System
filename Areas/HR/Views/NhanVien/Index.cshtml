@model EmployeeIndexViewModel
@{
    ViewData["Title"] = "Nhân viên";
    var departments = (IEnumerable<PhongBan>)ViewBag.PhongBans;
    var positions = (IEnumerable<ChucVu>)ViewBag.ChucVus;
}

<div class="page-container">
    <!-- Panel Tìm kiếm -->
    <div class="custom-panel">
        <div class="panel-header" data-bs-toggle="collapse" data-bs-target="#searchSection">
            <span>Nhân viên</span>
            <span class="toggle-icon">▲</span>
        </div>
        <div id="searchSection" class="collapse show">
            <form method="get" data-auto-submit-search>
                @if (Model.WithoutContract)
                {
                    <input type="hidden" name="withoutContract" value="true" />
                    <input type="hidden" name="contractMonth" value="@Model.ContractMonth" />
                    <input type="hidden" name="contractYear" value="@Model.ContractYear" />
                }
                <div class="row g-4 align-items-end">
                    <div class="col-md-2">
                        <label class="custom-label">Tìm kiếm</label>
                        <input name="search" value="@Model.Search" class="custom-input" placeholder="Mã, tên hoặc email" />
                    </div>
                    <div class="col-md-2">
                        <label class="custom-label">Phòng ban</label>
                        <select name="departmentId" class="custom-input form-select">
                            <option value="">Tất cả</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.ID" selected="@(Model.DepartmentId == d.ID)">@d.Tenphongban</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="custom-label" for="employee-position">Chức vụ</label>
                        <select id="employee-position" name="positionId" class="custom-input form-select">
                            <option value="">Tất cả</option>
                            @foreach (var position in positions)
                            {
                                <option value="@position.ID" selected="@(Model.PositionId == position.ID)">@position.Chucvu</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="showInactive" value="true" id="inactive" checked="@Model.ShowInactive"/>
                            <label class="form-check-label custom-label mb-0" for="inactive" style="margin-top:2px;">Nhân viên đã nghỉ</label>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex justify-content-end gap-3">
                        <a class="btn-green-outline" asp-action="Index">Tất cả</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.WithoutContract)
    {
        <div class="alert alert-warning">Đang hiển thị nhân viên chưa có hợp đồng hiệu lực trong kỳ @Model.ContractMonth/@Model.ContractYear.</div>
    }

    <!-- Panel Kết quả -->
    <div class="custom-panel">
        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a class="btn-green-solid" asp-action="Create">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Thêm nhân viên
            </a>
        }
        <div class="record-count">(@Model.Items.Count) Records Found</div>

        <div class="table-wrapper">
            <table class="custom-table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Nhân viên</th>
                    <th>Phòng ban</th>
                    <th>Chức vụ</th>
                    <th>Ngày vào</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model.Items)
                {
                    <tr>
                        <td><strong>@n.MaNhanVien</strong></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(n.AnhDaiDien))
                                {
                                    <img class="employee-avatar" src="@Url.Action("Employee", "Avatar", new { area = "", id = n.ID, v = n.AnhDaiDien })" alt="Ảnh đại diện của @n.Ten" />
                                }
                                else
                                {
                                    <span class="employee-avatar employee-avatar-placeholder" aria-hidden="true">@n.Ten.Trim()[0].ToString().ToUpperInvariant()</span>
                                }
                                <div>
                                    <a asp-action="Detail" asp-route-id="@n.ID" class="fw-semibold text-decoration-none" style="color:#4a5468;">@n.Ten</a>
                                    <div class="small text-muted">@n.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>@(n.PhongBan?.Tenphongban ?? "—")</td>
                        <td>@(n.ChucVu?.Chucvu ?? "—")</td>
                        <td>@n.Ngayvaolam.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge-status @(n.Trangthai ? "status-success" : "status-danger")">@(n.Trangthai ? "Đang làm" : "Đã nghỉ")</span></td>
                        <td class="text-center">
                            <a asp-action="Detail" asp-route-id="@n.ID" class="action-btn" title="Chi tiết" style="text-decoration:none;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </a>
                            @if(User.IsInRole("Admin") || User.IsInRole("HR"))
                            {
                                <a asp-action="Edit" asp-route-id="@n.ID" class="action-btn" title="Sửa" style="text-decoration:none;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4" style="color:#5c6c85;">Không tìm thấy nhân viên.</td>
                    </tr>
                }
            </tbody>
            </table>
        </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 mb-0">
            <ul class="pagination justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-departmentId="@Model.DepartmentId" asp-route-positionId="@Model.PositionId" asp-route-showInactive="@Model.ShowInactive" asp-route-withoutContract="@Model.WithoutContract" asp-route-contractMonth="@Model.ContractMonth" asp-route-contractYear="@Model.ContractYear">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
    </div>
</div>
