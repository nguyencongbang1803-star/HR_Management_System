@model InternalPortalViewModel
@{
    ViewData["Title"]="Cổng thông tin nội bộ";
    var canManage=User.IsInRole("Admin")||User.IsInRole("HR");
    var departments=(IEnumerable<QLNS.Models.Entities.PhongBan>)ViewBag.PhongBans;
    var positions=(IEnumerable<QLNS.Models.Entities.ChucVu>)ViewBag.ChucVus;
}

<div class="page-container">
    <div class="custom-panel d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h4 style="color: #4a5468; font-weight: 700; margin-bottom: 5px;">Cổng thông tin nội bộ</h4>
            <p class="text-muted mb-0">Chính sách, thông báo, khảo sát và trợ lý tra cứu quy chế.</p>
        </div>
    </div>

    <!-- Hỏi trợ lý quy chế -->
