@{ 
    ViewData["Title"] = "Phòng ban & chức vụ"; 
    var departments = (IEnumerable<PhongBan>)ViewBag.PhongBans;
    var positions = (IEnumerable<ChucVu>)ViewBag.ChucVus;
    var employees = (IEnumerable<NhanVien>)ViewBag.NhanViens; 
}

<div class="page-container">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="custom-panel">
                <div class="panel-header"><strong>Phòng ban</strong></div>
                <div class="panel-body pt-3">
                    <form asp-action="SaveDepartment" method="post" class="row g-2 mb-4 align-items-end">
                        <div class="col-md-5">
                            <label class="custom-label">Tên phòng ban</label>
                            <input name="Tenphongban" class="custom-input" required maxlength="150"/>
                        </div>
                        <div class="col-md-5">
                            <label class="custom-label">Trưởng phòng</label>
                            <select name="Matruongphong" class="custom-input form-select employee-select">
                                <option value="">Chọn</option>
                                @foreach(var n in employees){<option value="@n.ID" data-employee-code="@n.MaNhanVien" data-employee-name="@n.Ten">@n.MaNhanVien - @n.Ten</option>}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn-green-solid w-100 p-2">Thêm</button>
                        </div>
                    </form>
                    <div class="record-count">(@departments.Count()) Records Found</div>
                    <div class="table-wrapper">
                        <table class="custom-table">
                            <thead><tr><th>Tên phòng ban</th><th>Nhân sự</th><th></th></tr></thead>
                            <tbody>
                                @foreach(var x in departments){
                                    <tr>
                                        <td>@x.Tenphongban</td>
                                        <td>@x.NhanViens.Count</td>
                                        <td>
                                            <form asp-action="DeleteDepartment" asp-route-id="@x.ID" method="post" onsubmit="return confirm('Xóa phòng ban này?')">
                                                <button class="action-btn" title="Xóa"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if(!departments.Any()){<tr><td colspan="3" class="text-center py-4" style="color:#5c6c85;">Chưa có phòng ban.</td></tr>}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="custom-panel">
                <div class="panel-header"><strong>Chức vụ</strong></div>
                <div class="panel-body pt-3">
                    <form asp-action="SavePosition" method="post" class="row g-2 mb-4 align-items-end">
                        <div class="col-md-5">
                            <label class="custom-label">Tên chức vụ</label>
                            <input name="Chucvu" class="custom-input" required maxlength="100"/>
                        </div>
                        <div class="col-md-4">
                            <label class="custom-label">Hệ số</label>
                            <input name="Hesoluong" type="number" min="0" step="0.01" class="custom-input"/>
                        </div>
                        <div class="col-md-3">
                            <button class="btn-green-solid w-100 p-2">Thêm</button>
                        </div>
                    </form>
                    <div class="record-count">(@positions.Count()) Records Found</div>
                    <div class="table-wrapper">
                        <table class="custom-table">
                            <thead><tr><th>Chức vụ</th><th>Hệ số</th><th>Nhân sự</th><th></th></tr></thead>
                            <tbody>
                                @foreach(var x in positions){
                                    <tr>
                                        <td>@x.Chucvu</td>
                                        <td>@x.Hesoluong</td>
                                        <td>@x.NhanViens.Count</td>
                                        <td>
                                            <form asp-action="DeletePosition" asp-route-id="@x.ID" method="post" onsubmit="return confirm('Xóa chức vụ này?')">
                                                <button class="action-btn" title="Xóa"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if(!positions.Any()){<tr><td colspan="4" class="text-center py-4" style="color:#5c6c85;">Chưa có chức vụ.</td></tr>}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
