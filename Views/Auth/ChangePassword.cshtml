@model QLNS.Models.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }

<div class="page-container">
    <div class="custom-panel">
        <div class="panel-header">Đổi mật khẩu</div>
        <form asp-controller="Auth" asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="custom-label required"></label>
                <div class="input-group"><input asp-for="CurrentPassword" class="custom-input rounded-end-0" autocomplete="current-password" /><button type="button" class="btn-green-outline rounded-start-0 password-toggle" data-password-toggle="#CurrentPassword" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false"></button></div>
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="custom-label required"></label>
                <div class="input-group"><input asp-for="NewPassword" class="custom-input rounded-end-0" autocomplete="new-password" /><button type="button" class="btn-green-outline rounded-start-0 password-toggle" data-password-toggle="#NewPassword" aria-label="Hiện mật khẩu mới" aria-pressed="false"></button></div>
                <small class="text-muted">Ít nhất 8 ký tự, gồm một chữ số và một ký tự đặc biệt.</small>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="custom-label required"></label>
                <div class="input-group"><input asp-for="ConfirmPassword" class="custom-input rounded-end-0" autocomplete="new-password" /><button type="button" class="btn-green-outline rounded-start-0 password-toggle" data-password-toggle="#ConfirmPassword" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"></button></div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="text-end"><button class="btn-green-solid">Lưu mật khẩu mới</button></div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
