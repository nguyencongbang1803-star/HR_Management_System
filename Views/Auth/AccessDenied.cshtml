@{ ViewData["Title"] = "Không có quyền truy cập"; }

<div class="page-container">
    <div class="custom-panel text-center py-5">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#b42318" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
        <div class="panel-header justify-content-center">Không có quyền truy cập</div>
        <p class="text-muted">Tài khoản của bạn không được phép thực hiện chức năng này.</p>
        @if (User.IsInRole("NhanVien"))
        {
            <a class="btn-green-solid" asp-area="Employee" asp-controller="Home" asp-action="Index">Về trang cá nhân</a>
        }
        else
        {
            <a class="btn-green-solid" asp-area="HR" asp-controller="Dashboard" asp-action="Index">Về tổng quan</a>
        }
    </div>
</div>
