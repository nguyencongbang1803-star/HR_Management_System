@model QLNS.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ff7b1d" />
    <title>Đăng nhập - TIC HRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="login-shell">
        <section class="login-form-side">
            <a class="login-brand" href="/" aria-label="TIC HRM">
                <span class="brand-logo" aria-hidden="true"><span>T</span></span>
                <span class="login-brand-copy">
                    <strong>TIC HRM</strong>
                    <small>Human Resources</small>
                </span>
            </a>

            <div class="login-card">
                <span class="login-kicker">Chào mừng trở lại</span>
                <h1 class="login-title">Đăng nhập</h1>
                <p class="login-subtitle">Sử dụng email hoặc mã nhân viên để truy cập hệ thống.</p>

                <form asp-controller="Auth" asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="form-group-custom">
                        <label asp-for="TaiKhoan" class="required">Email hoặc mã nhân viên</label>
                        <input asp-for="TaiKhoan" class="form-control form-control-custom" autocomplete="username" placeholder="email@congty.vn hoặc NV001" autofocus />
                        <span asp-validation-for="TaiKhoan" class="text-danger small"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Password" class="required">Mật khẩu</label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control form-control-custom custom-input" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                            <button class="btn password-toggle" type="button" data-password-toggle="#Password" aria-label="Hiện mật khẩu"></button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="login-actions">
                        <div class="form-check mb-0">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                        </div>
                        <span>Hỗ trợ nội bộ</span>
                    </div>

                    <button class="btn btn-login w-100" type="submit">Đăng nhập</button>
                </form>

                <div class="login-footer">TIC HRM OS 1.0 · © 2024–2026 TIC HRM</div>
            </div>
        </section>

        <section class="login-visual" aria-label="Giới thiệu hệ thống">
            <div class="login-visual-card">
                <div class="login-visual-mark" aria-hidden="true">HR</div>
                <h2>Quản trị nhân sự nhẹ nhàng hơn mỗi ngày.</h2>
                <p>Một không gian thống nhất để quản lý hồ sơ, chấm công, nghỉ phép, hợp đồng và chế độ nhân viên.</p>
                <ul class="login-feature-list">
                    <li>Hồ sơ tập trung</li>
                    <li>Vận hành minh bạch</li>
                    <li>Báo cáo nhanh</li>
                </ul>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
